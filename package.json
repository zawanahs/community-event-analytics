    "papaparse": "^5.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sentiment": "^5.0.2"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sentiment": "^5.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.1"
  }
}
